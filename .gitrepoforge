name: "pubsub2postgresaudit"
default_branch: "main"
config:
  description: "Pulls GCP Pub/Sub messages and persists payload + attributes to a PostgreSQL audit table."
  license: "MIT"
  language: "go"
  release: "docker-go"
  release_github: false
  status: "wip"
  justfile: true
  codecov:
    enabled: true
  docs:
    enabled: true
    domain: "pubsub2postgresaudit.unitvectorylabs.com"
  gitignore:
    - ".env"
    - "node_modules/"
    - "package.json"
    - "package-lock.json"
